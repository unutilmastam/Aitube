generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "postgresql"
  url      = env("DATABASE_URL")
}

enum Role {
  USER
  ADMIN
}

enum ProjectStatus {
  DRAFT
  SCRIPT_READY
  SCENES_READY
  VOICE_READY
  RENDERING
  DONE
  FAILED
}

enum Niche {
  EDUCATIONAL
  HISTORY
  TECHNOLOGY
  SCIENCE
  BUSINESS
  MOTIVATION
  ENTERTAINMENT
  FACTS
  STORIES
}

model User {
  id           String    @id @default(uuid())
  email        String    @unique
  passwordHash String
  role         Role      @default(USER)
  credits      Int       @default(10)
  createdAt    DateTime  @default(now())
  updatedAt    DateTime  @updatedAt

  projects      Project[]
  refreshTokens RefreshToken[]
  auditLogs     AuditLog[]

  @@map("users")
}

model RefreshToken {
  id        String   @id @default(uuid())
  token     String   @unique
  userId    String
  user      User     @relation(fields: [userId], references: [id], onDelete: Cascade)
  expiresAt DateTime
  createdAt DateTime @default(now())
  revoked   Boolean  @default(false)

  @@map("refresh_tokens")
  @@index([userId])
}

model Project {
  id        String        @id @default(uuid())
  userId    String
  user      User          @relation(fields: [userId], references: [id], onDelete: Cascade)
  title     String
  niche     Niche
  language  String        @default("uz")
  status    ProjectStatus @default(DRAFT)
  createdAt DateTime      @default(now())
  updatedAt DateTime      @updatedAt

  scripts Script[]
  renderJobs RenderJob[]
  thumbnails Thumbnail[]
  seoMeta    SeoMeta?

  @@map("projects")
  @@index([userId])
}

model Script {
  id               String   @id @default(uuid())
  projectId        String
  project          Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  content          String   @db.Text
  wordCount        Int
  generatedByModel String
  version          Int      @default(1)
  audioFileUrl     String?
  createdAt        DateTime @default(now())

  scenes Scene[]

  @@map("scripts")
  @@index([projectId])
}

enum TransitionType {
  CUT
  FADE
  SLIDE
  ZOOM
}

model Scene {
  id            String          @id @default(uuid())
  scriptId      String
  script        Script          @relation(fields: [scriptId], references: [id], onDelete: Cascade)
  order         Int
  narration     String          @db.Text
  visualPrompt  String          @db.Text
  cameraMotion  String          @default("static") // static | pan-left | pan-right | zoom-in | zoom-out
  transition    TransitionType  @default(FADE)
  durationSec   Float           @default(5)
  audioFileUrl  String?
  audioDuration Float?
  visualFileUrl String?
  subtitleText  String?         @db.Text
  createdAt     DateTime        @default(now())
  updatedAt     DateTime        @updatedAt

  @@map("scenes")
  @@index([scriptId])
  @@unique([scriptId, order])
}

enum RenderStatus {
  QUEUED
  PROCESSING
  DONE
  FAILED
}

model RenderJob {
  id           String       @id @default(uuid())
  projectId    String
  project      Project      @relation(fields: [projectId], references: [id], onDelete: Cascade)
  scriptId     String
  status       RenderStatus @default(QUEUED)
  progress     Int          @default(0) // 0-100
  outputFileUrl String?
  errorLog     String?      @db.Text
  createdAt    DateTime     @default(now())
  updatedAt    DateTime     @updatedAt

  @@map("render_jobs")
  @@index([projectId])
}

model Thumbnail {
  id         String   @id @default(uuid())
  projectId  String
  project    Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  imageUrl   String
  variant    Int // 1, 2, 3 — bir nechta variant taqdim etiladi
  headline   String? // thumbnail ustiga chiqadigan qisqa matn
  isSelected Boolean  @default(false)
  createdAt  DateTime @default(now())

  @@map("thumbnails")
  @@index([projectId])
}

model SeoMeta {
  id          String   @id @default(uuid())
  projectId   String   @unique
  project     Project  @relation(fields: [projectId], references: [id], onDelete: Cascade)
  title       String
  description String   @db.Text
  tags        String[]
  hashtags    String[]
  chapters    Json? // [{ time: "0:00", label: "Kirish" }, ...]
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("seo_meta")
}

model AuditLog {
  id        String   @id @default(uuid())
  userId    String?
  user      User?    @relation(fields: [userId], references: [id], onDelete: SetNull)
  action    String
  metadata  Json?
  ip        String?
  createdAt DateTime @default(now())

  @@map("audit_logs")
  @@index([userId])
}
