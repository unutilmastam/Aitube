# --- Postgres ---
POSTGRES_USER=platform
POSTGRES_PASSWORD=platform_pass
POSTGRES_DB=platform_db
DATABASE_URL=postgresql://platform:platform_pass@postgres:5432/platform_db?schema=public

# --- Redis ---
REDIS_URL=redis://redis:6379

# --- MinIO ---
MINIO_ROOT_USER=platform_admin
MINIO_ROOT_PASSWORD=platform_secret
MINIO_ENDPOINT=minio
MINIO_PORT=9000
MINIO_BUCKET=platform-media

# --- Auth ---
JWT_ACCESS_SECRET=change_me_access_secret_min_32_chars
JWT_REFRESH_SECRET=change_me_refresh_secret_min_32_chars
JWT_ACCESS_EXPIRES=15m
JWT_REFRESH_EXPIRES=30d

# --- AI Providers (Phase 1: faqat Script + Voice) ---
OPENAI_API_KEY=
ELEVENLABS_API_KEY=

# --- Server ---
PORT=4000
NODE_ENV=development
